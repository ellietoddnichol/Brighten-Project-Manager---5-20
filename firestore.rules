      allow update: if isSignedIn() && isValidId(lineId) && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(lineId) && existing().ownerId == request.auth.uid;
