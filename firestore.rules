    match /ar-records/{arId} {
      allow get: if isSignedIn() && isValidId(arId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(arId) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(arId) && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(arId) && existing().ownerId == request.auth.uid;
