    match /activity-events/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(eventId) && incoming().ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /import-exceptions/{exceptionId} {
      allow get: if isSignedIn() && isValidId(exceptionId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
