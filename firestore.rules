rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(projectId) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid;
    }

    match /pos/{poId} {
      allow get: if isSignedIn() && isValidId(poId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(poId) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(poId) && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(poId) && existing().ownerId == request.auth.uid;
    }

    match /change-orders/{coId} {
      allow get: if isSignedIn() && isValidId(coId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(coId) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(coId) && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(coId) && existing().ownerId == request.auth.uid;
    }

    match /change-requests/{crId} {
      allow get: if isSignedIn() && isValidId(crId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(crId) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(crId) && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(crId) && existing().ownerId == request.auth.uid;
    }

    match /rfis/{rfiId} {
      allow get: if isSignedIn() && isValidId(rfiId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(rfiId) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(rfiId) && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(rfiId) && existing().ownerId == request.auth.uid;
    }

    match /submittals/{submittalId} {
      allow get: if isSignedIn() && isValidId(submittalId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(submittalId) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(submittalId) && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(submittalId) && existing().ownerId == request.auth.uid;
    }

    match /daily-logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(logId) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(logId) && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(logId) && existing().ownerId == request.auth.uid;
    }

    match /field-issues/{issueId} {
      allow get: if isSignedIn() && isValidId(issueId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(issueId) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(issueId) && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(issueId) && existing().ownerId == request.auth.uid;
