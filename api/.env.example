# Cloud SQL MySQL — copy to .env.local for local dev (never commit .env.local)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=brighten_pm
DB_USER=
DB_PASSWORD=

# Optional Cloud SQL Auth Proxy / connector (Cloud Run)
# INSTANCE_CONNECTION_NAME=project:region:instance
# GOOGLE_CLOUD_PROJECT=
# DB_SOCKET_PATH=/cloudsql/project:region:instance

API_PORT=8080
CORS_ORIGIN=http://localhost:3000

# Webhook verification (Cloud Run + local api/.env.local)
# QB_WEBHOOK_VERIFIER_TOKEN=          # From Intuit Developer Portal → Webhooks
# DRIVE_WEBHOOK_CHANNEL_TOKEN=        # Random secret shared with Angular localStorage
