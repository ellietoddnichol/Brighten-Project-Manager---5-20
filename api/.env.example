# Cloud SQL MySQL — copy to .env.local for local dev (never commit .env.local)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=brighten_pm
DB_USER=
DB_PASSWORD=

# Cloud Run production (set in service env / Secret Manager — never in the Angular build)
# DB_SOCKET_PATH=/cloudsql/project-manager-498120:us-central1:databaseprojectmgmt63
# DB_NAME=brighten_pm
# DB_USER=
# DB_PASSWORD=          # use Secret Manager on Cloud Run
# APP_STATIC_DIR=/app/public
# CORS_ORIGIN=https://projectmanager06-XXXX.europe-west1.run.app

API_PORT=8080
CORS_ORIGIN=http://localhost:3000

# Firebase Auth on /api/* (health stays open). Set false for local API-only testing.
API_AUTH_REQUIRED=false
FIREBASE_PROJECT_ID=brighten-project-manager

# Webhook verification (Cloud Run + local api/.env.local)
# QB_WEBHOOK_VERIFIER_TOKEN=          # From Intuit Developer Portal → Webhooks
# DRIVE_WEBHOOK_CHANNEL_TOKEN=        # Random secret shared with Angular localStorage
